{
    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "rootDir": "./static/ts",
        "outDir": "./static/js",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["static/ts/**/*"]
}